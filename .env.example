APP_ENV=development
HTTP_ADDR=:8080
APP_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379
POSTGRES_PASSWORD=change-this-local-password

# openssl rand -base64 32 로 서로 다른 값을 생성하세요.
JWT_SECRET=REPLACE_WITH_BASE64_32_RANDOM_BYTES
CODE_SECRET=REPLACE_WITH_ANOTHER_BASE64_32_RANDOM_BYTES
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=336h
BCRYPT_COST=12
COOKIE_SECURE=false
WEB_ORIGIN=https://localhost:5173
API_BASE_URL=http://localhost:8080

# Profile/team/project image uploads are stored in the Docker uploads volume.
MEDIA_STORAGE_DIR=./uploads
MEDIA_MAX_IMAGE_BYTES=5242880

# Optional OAuth providers. Register each exact callback URL shown below.
# Google: http://localhost:8080/api/v1/auth/oauth/google/callback
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
# Kakao: http://localhost:8080/api/v1/auth/oauth/kakao/callback
OAUTH_KAKAO_CLIENT_ID=
OAUTH_KAKAO_CLIENT_SECRET=
# X: http://localhost:8080/api/v1/auth/oauth/x/callback
OAUTH_X_CLIENT_ID=
OAUTH_X_CLIENT_SECRET=
# Apple: http://localhost:8080/api/v1/auth/oauth/apple/callback (form_post)
OAUTH_APPLE_CLIENT_ID=
OAUTH_APPLE_TEAM_ID=
OAUTH_APPLE_KEY_ID=
# Base64-encoded .p8 PEM contents. Keep this secret out of Git.
OAUTH_APPLE_PRIVATE_KEY_B64=

# 개발에서는 console을 사용하면 코드와 재설정 토큰이 앱 로그에만 출력됩니다.
SMTP_HOST=console
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@scenespect.local
SMTP_ALLOW_INSECURE=false
